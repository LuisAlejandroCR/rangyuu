# .env.example: las variables que el runtime espera. Este archivo SE VERSIONA y no lleva valores.
# Los valores reales van en .env.local, que está en .gitignore y jamás se commitea.

# Token corto del Developer Playground. Sirve para GET /v1/devices y live view; caduca.
RANGYUU_ACCESS_TOKEN=

# Credenciales de la app Rangyuu registrada en Ring. Necesarias para webhooks y para renovar solo.
RANGYUU_CLIENT_ID=
RANGYUU_CLIENT_SECRET=
RANGYUU_REFRESH_TOKEN=

# Endpoint de intercambio del refresh token. ⏳ PENDIENTE: la ruta exacta no está verificada
# contra la documentación oficial; se configura en vez de codificarse (ver B1 en docs/plan.md).
RANGYUU_TOKEN_URL=

# Secreto compartido con el que Ring firma el webhook (HMAC-SHA256 del cuerpo crudo).
RANGYUU_WEBHOOK_SECRET=

# URL pública que recibe los webhooks durante el desarrollo (túnel).
RANGYUU_WEBHOOK_URL=

# Configuración propia de Rangyuu (no la emite Ring).
RANGYUU_PROVIDER_URL=
RANGYUU_PROVIDER_TOKEN=
